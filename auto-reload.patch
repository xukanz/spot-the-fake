+
+.home-art{display:none}
+.art-note{background:var(--sun);border:2px solid var(--ink);padding:10px 16px 12px;box-shadow:3px 4px 0 var(--ink);position:absolute;z-index:3}
+.art-note small{display:block;font-size:11px;font-weight:700;color:#6B5500}
+.art-note b{font-family:var(--hand);font-weight:400;font-size:28px;line-height:1}
+.art-note-b{background:#ECE6FF}.art-note-b small{color:#4B3A9C}
+.art-tag{position:absolute;font-family:var(--hand);font-size:24px;color:#fff;background:var(--c);border:2px solid var(--ink);border-radius:10px;padding:0 10px;transform:rotate(8deg)}
+.art-caps{display:flex;gap:10px}
+
+/* Desktop: use the width instead of a centered phone column */
+@media (min-width:900px){
+  main{max-width:1180px;padding:40px 32px 56px;min-height:100vh;display:flex;flex-direction:column;justify-content:center}
+  main>section{width:100%}
+  .narrow{max-width:none;margin:0}
+
+  #home{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.05fr);min-height:min(680px,calc(100vh - 96px))}
+  #home .entry{min-height:0;padding:48px 56px}
+  #homeMenu{padding-top:56px}
+  #homeMenu .floaty{display:none}
+  .logo h1{font-size:64px}
+  .lede{font-size:18px;margin:10px 0 34px}
+  .entry h2{font-size:38px}
+  #createPanel,#joinPanel{justify-content:center}
+  #createPanel form,#joinPanel form{max-width:420px}
+  .home-art{display:grid;place-items:center;position:relative;background:var(--wash);border-left:2.5px solid var(--ink);padding:56px;overflow:hidden;
+    background-image:radial-gradient(#DCD9F0 1.4px,transparent 1.5px);background-size:22px 22px}
+  .art-paper{width:min(78%,380px);aspect-ratio:1;transform:rotate(-2deg)}
+  .art-paper svg{position:absolute;inset:0;width:100%;height:100%}
+  .art-note-a{top:9%;left:8%;transform:rotate(-6deg)}
+  .art-note-b{bottom:12%;right:8%;transform:rotate(5deg)}
+  .art-caps{position:absolute;bottom:9%;left:9%}
+
+  #lobby{display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);padding:0;min-height:min(620px,calc(100vh - 96px));
+    grid-template-areas:"label roster" "code roster" "invite roster" "notice roster" "foot roster";grid-template-rows:1fr auto auto auto 1fr}
+  #lobby>.label{grid-area:label;align-self:end;padding:40px 48px 0;font-size:16px}
+  #roomCode{grid-area:code;padding:0 48px}
+  .code b{width:80px;height:100px;font-size:56px;border-radius:16px;box-shadow:0 7px 0 var(--ink)}
+  #invite{grid-area:invite;margin:28px auto 8px}
+  #notice{grid-area:notice;margin:12px 48px 0}
+  .lobby-foot{grid-area:foot;padding:24px 48px 40px;align-self:end;width:100%;max-width:440px;justify-self:center}
+  .roster{grid-area:roster;padding:44px 44px 48px;border-left:2.5px solid var(--ink);background:var(--wash)}
+  .roster .list-head{font-size:20px;margin-bottom:16px}
+  #lobbyPlayers{grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
+  #lobbyPlayers li{background:#fff;border:2.5px solid var(--ink);border-radius:16px;padding:10px 12px;box-shadow:0 4px 0 var(--ink)}
+  #lobbyPlayers li:has(.waiting){background:transparent;border-style:dashed;box-shadow:none}
+  #lobbyPlayers .waiting{font-size:19px}
+
+  .game-sheet{padding:0}
+  .game-top{padding:20px 28px 14px}
+  .turns{padding:0 28px 14px}
+  .banner{margin:0 28px 20px}
+  .game-grid{grid-template-columns:minmax(0,1fr) 340px;gap:0;padding:0;border-top:2.5px solid var(--ink)}
+  .board-wrap{padding:28px;display:flex;flex-direction:column;align-items:center;background:var(--wash)}
+  .board-wrap .paper{width:min(100%,calc(100vh - 330px),640px);min-width:360px}
+  .draw-actions{width:min(100%,calc(100vh - 330px),640px);min-width:360px}
+  .side{padding:24px;border-left:2.5px solid var(--ink)}
+  #messages{height:min(320px,calc(100vh - 480px));min-height:160px}
+
+  #results{display:grid;grid-template-columns:minmax(0,.85fr) minmax(0,1.15fr);grid-template-areas:"hero body" "hero actions";grid-template-rows:1fr auto}
+  .res .hero{grid-area:hero;border-bottom:0;border-right:2.5px solid var(--ink);display:flex;flex-direction:column;justify-content:center;align-items:center;padding:48px 32px;min-height:560px}
+  .stamp{font-size:76px}
+  .hero h2{font-size:38px;margin-top:24px}
+  .hero p{font-size:16px}
+  .res-body{grid-area:body;padding:32px 32px 8px;gap:18px}
+  .flip{height:104px}.flip .back b{font-size:32px}
+  .replay{grid-template-columns:220px 1fr;gap:20px}
+  .who{font-size:28px}
+  .res-actions{grid-area:actions;padding:12px 32px 32px}
+}
