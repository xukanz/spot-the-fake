+.list-head{display:flex;justify-content:space-between;align-items:baseline;margin:0 0 10px;font-size:17px}
+.players{list-style:none;margin:0;padding:0;display:grid;gap:10px}
+.players li{display:flex;align-items:center;gap:12px;font-weight:700}
+.players .pop{animation:popin .45s cubic-bezier(.2,1.6,.4,1) both}
+@keyframes popin{from{transform:scale(.5);opacity:0}}
+.players .tag{margin-left:auto;font-size:12px;font-weight:700;padding:4px 10px;border-radius:999px;background:var(--wash);color:var(--ink-soft)}
+.players .tag.host{background:var(--ink);color:#fff}
+.players .offline{opacity:.45}
+.waiting{font-family:var(--hand);font-weight:400;font-size:21px;color:var(--ink-soft)}
+.lobby-foot{margin-top:auto;padding-top:20px;display:grid;gap:10px;justify-items:center}
+.lobby-foot .btn{width:100%}
+
+/* game */
+.game-sheet{padding-bottom:18px}
+.game-top{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:18px 18px 12px}
+.sticky{background:var(--sun);padding:9px 14px 10px;transform:rotate(-3deg);box-shadow:3px 4px 0 var(--ink);border:2px solid var(--ink);text-align:left;cursor:pointer;min-width:0}
+.sticky small{display:block;font-size:11px;font-weight:700;color:#6B5500}
+.sticky b{display:block;font-family:var(--hand);font-weight:400;font-size:28px;line-height:1.05;overflow-wrap:anywhere}
+.phase-box{display:flex;align-items:center;gap:10px;text-align:right}
+.timer{--p:100%;--tc:var(--m-red);width:56px;height:56px;border-radius:50%;display:grid;place-items:center;font-weight:800;font-size:18px;position:relative;flex:none;border:2.5px solid var(--ink);
+  background:conic-gradient(var(--tc) 0 var(--p),var(--line) var(--p) 100%)}
+.timer::before{content:"";position:absolute;inset:6px;border-radius:50%;background:#fff;border:2px solid var(--ink)}
+.timer span{position:relative;font-variant-numeric:tabular-nums}
+.timer.hot{animation:pulse 1s ease-in-out infinite}
+@keyframes pulse{50%{transform:scale(1.08)}}
+.turns{display:flex;gap:6px;padding:0 18px 12px;align-items:center}
+.turns .t{height:10px;flex:1;border-radius:5px;opacity:.25;border:2px solid transparent;transition:all .25s}
+.turns .t.done{opacity:1}
+.turns .t.now{opacity:1;height:18px;border-color:var(--ink)}
+.banner{margin:0 18px 16px;padding:11px 14px;border-radius:14px;background:var(--ink);color:#fff;font-weight:700;font-size:15px;display:flex;align-items:center;gap:10px}
+.banner .dot{width:14px;height:14px;border-radius:50%;flex:none;box-shadow:0 0 0 2px #fff;background:var(--sun)}
+.banner.mine{background:var(--sun);color:var(--ink);border:2.5px solid var(--ink)}
+.banner.mine .dot{box-shadow:0 0 0 2px var(--ink);animation:blink 1.2s infinite}
+@keyframes blink{50%{opacity:.35}}
+.game-grid{display:grid;grid-template-columns:minmax(0,1fr) 320px;gap:24px;padding:0 18px}
+.board-wrap .muted{margin:14px 0 0}
+.paper{position:relative;border:2.5px solid var(--ink);border-radius:8px;box-shadow:5px 5px 0 var(--ink);background:#fff}
+.paper::before,.paper::after{content:"";position:absolute;width:56px;height:18px;background:rgba(255,210,63,.8);top:-9px;z-index:2;pointer-events:none}
+.paper::before{left:14px;transform:rotate(-6deg)}.paper::after{right:14px;transform:rotate(5deg)}
+.paper.small::before,.paper.small::after{display:none}
+.paper.small{box-shadow:3px 3px 0 var(--ink)}
+.paper canvas{display:block;width:100%;aspect-ratio:1;border-radius:6px;touch-action:none;
+  background-color:#fff;background-image:radial-gradient(#DCD9F0 1.2px,transparent 1.3px);background-size:18px 18px}
+#board.can-draw{cursor:crosshair}
+.side{display:grid;gap:18px;align-content:start}
+.players.compact li{font-size:15px}
+.vote-btn{display:flex;align-items:center;gap:10px;width:100%;padding:7px 10px;border:2.5px solid var(--line);border-radius:14px;font-weight:700;cursor:pointer;background:#fff;text-align:left}
+.vote-btn .pick{margin-left:auto;font-size:13px;padding:5px 12px;border-radius:999px;background:var(--wash)}
+.vote-btn:hover{border-color:var(--ink)}
+.vote-btn.picked{border-color:var(--ink);background:var(--sun);box-shadow:0 4px 0 var(--ink)}
+.vote-btn.picked .pick{background:var(--ink);color:#fff}
+.vote-btn:disabled{cursor:default}
+.vote-btn:disabled:not(.picked){opacity:.55}
+#messages{height:200px;overflow:auto;background:var(--wash);border:2px solid var(--line);border-radius:12px;padding:10px;margin-bottom:10px;overflow-wrap:anywhere}
+#messages p{margin:0 0 8px;font-size:14px;line-height:1.35}
+#messages .who{font-family:var(--display);font-size:14px;font-weight:800}
+
+/* results */
+.res .hero{position:relative;padding:28px 18px 22px;text-align:center;overflow:hidden;cursor:pointer;border-bottom:2.5px solid var(--ink);transition:background .4s}
+.res.win .hero{background:var(--sun)}
+.res.lose .hero{background:#2C2966;color:#fff}
+.rays{position:absolute;inset:-60%;background:repeating-conic-gradient(rgba(255,255,255,.55) 0 8deg,transparent 8deg 24deg);animation:spin 18s linear infinite;opacity:0;transition:opacity .4s}
+.res.win .rays{opacity:1}
+@keyframes spin{to{transform:rotate(1turn)}}
+#fx{position:absolute;inset:0;width:100%;height:100%;pointer-events:none}
+.stamp{position:relative;font-family:var(--hand);font-size:56px;border:5px solid currentColor;border-radius:14px;padding:0 18px;display:inline-block;line-height:1.1;background:#fff}
+.res.win .stamp{color:var(--m-red);transform:rotate(-7deg)}
+.res.lose .stamp{color:#8F8CB8;background:transparent;transform:rotate(6deg);border-style:dashed}
+.stamp.slam{animation:slam .55s cubic-bezier(.2,1.4,.4,1) both}
+@keyframes slam{from{transform:scale(2.6) rotate(-20deg);opacity:0}}
+.stamp.wobble{animation:wobble .6s ease}
+@keyframes wobble{20%{transform:rotate(14deg)}45%{transform:rotate(-4deg)}70%{transform:rotate(10deg)}}
+.hero h2{position:relative;margin:16px 0 4px;font-size:28px;font-weight:800}
+.hero p{position:relative;margin:0 auto;max-width:30ch;font-size:14px;line-height:1.45}
+.res.win .hero p{color:#5A4500}.res.lose .hero p{color:#C6C3EE}
+.role-pill{position:relative;display:inline-flex;margin-top:12px;font-weight:800;font-size:13px;padding:5px 12px;border-radius:999px;border:2.5px solid var(--ink);background:#fff;color:var(--ink)}
+.res.lose .role-pill{background:transparent;color:#C6C3EE;border-color:#5C59A0}
+.tap-hint{position:relative;font-size:11px;margin-top:10px;opacity:.7}
+.res-body{padding:18px;display:grid;gap:14px}
+.res-body > p{margin:-4px 0 0}
+.flips{display:grid;grid-template-columns:1fr 1fr;gap:10px;perspective:700px}
+.flip{position:relative;height:86px;cursor:pointer;border:0;padding:0;background:none}
+.flip>span{position:absolute;inset:0;padding:6px;border:2.5px solid var(--ink);border-radius:12px;display:grid;place-content:center;text-align:center;backface-visibility:hidden;transition:transform .6s cubic-bezier(.3,1.3,.5,1);box-shadow:0 4px 0 var(--ink)}
+.flip .front{background:var(--ink);color:#fff;font-weight:700;font-size:14px}
+.flip .back{background:#fff;transform:rotateY(180deg)}
+.flip.open .front{transform:rotateY(-180deg)}.flip.open .back{transform:rotateY(0)}
+.flip .back small{font-size:11px;color:var(--ink-soft);font-weight:700}
+.flip .back b{font-family:var(--hand);font-weight:400;font-size:26px;line-height:1;overflow-wrap:anywhere}
+#undercoverWord{color:var(--m-violet)}
+.replay{display:grid;grid-template-columns:128px 1fr;gap:14px;align-items:center}
+.replay p{margin:2px 0 10px}
+.who{font-family:var(--hand);font-size:22px;min-height:28px}
+.block-title{display:block;margin-bottom:8px;font-size:15px}
+.bars{list-style:none;margin:0;padding:0;display:grid;gap:7px;font-size:14px}
+.bars li{display:flex;align-items:center;gap:10px}
+.bars .name{width:84px;font-weight:700;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
+.bars .bar{height:12px;border-radius:6px;background:var(--line);flex:1;overflow:hidden;border:2px solid var(--ink)}
+.bars .bar i{display:block;height:100%;width:0;transition:width .8s cubic-bezier(.2,1,.3,1)}
+.bars b{width:16px;text-align:right}
+.reacts{display:flex;gap:6px;position:relative}
+.reacts button{flex:1;font-size:22px;border:2px solid var(--line);background:var(--wash);border-radius:12px;padding:6px 0;cursor:pointer}
+.reacts button:active{transform:scale(.9)}
+.flyer{position:absolute;bottom:20px;font-size:28px;pointer-events:none;animation:fly 1.4s ease-out forwards;z-index:3}
+@keyframes fly{to{transform:translateY(-220px) rotate(var(--r));opacity:0}}
+.res-actions{display:grid;grid-template-columns:1fr auto;gap:10px;padding:0 18px 20px;align-items:center}
+.res-actions .leave{width:auto}
+.res.win #again{animation:nudge 2.4s 2s ease-in-out infinite}
+@keyframes nudge{0%,80%,100%{transform:none}85%{transform:rotate(-2deg) scale(1.03)}90%{transform:rotate(2deg) scale(1.03)}}
+.res.lose #finalBoard{filter:saturate(.5)}
+
+@media (max-width:820px){
+  .game-grid{grid-template-columns:1fr}
+  .game-sheet{max-width:560px;margin:0 auto}
+}
+@media (max-width:480px){
+  main{padding:10px 10px 28px}
+  .narrow{margin:6px auto}
+  .entry,#lobby{min-height:calc(100vh - 40px)}
+  .code b{width:52px;height:64px;font-size:34px}
+  .game-top,.turns{padding-left:14px;padding-right:14px}
+  .banner{margin-left:14px;margin-right:14px}
+  .game-grid{padding:0 14px}
+  .replay{grid-template-columns:110px 1fr}
+}
+@media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}.swoosh path{stroke-dashoffset:0}}
